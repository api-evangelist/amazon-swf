            "body": {
              "mode": "raw",
              "raw": "{\n  \"domain\": \"<string>\",\n  \"name\": \"<string>\",\n  \"version\": \"<string>\",\n  \"description\": \"<string>\",\n  \"defaultTaskStartToCloseTimeout\": \"<string>\",\n  \"defaultExecutionStartToCloseTimeout\": \"<string>\",\n  \"defaultTaskList\": {\n    \"name\": \"<string>\"\n  },\n  \"defaultTaskPriority\": \"<string>\",\n  \"defaultChildPolicy\": \"ABANDON\",\n  \"defaultLambdaRole\": \"<string>\"\n}",
              "options": {
                "raw": {
