            "body": {
              "mode": "raw",
              "raw": "{\n  \"domain\": \"<string>\",\n  \"workflowId\": \"<string>\",\n  \"runId\": \"<string>\",\n  \"reason\": \"<string>\",\n  \"details\": \"<string>\",\n  \"childPolicy\": \"TERMINATE\"\n}",
              "options": {
