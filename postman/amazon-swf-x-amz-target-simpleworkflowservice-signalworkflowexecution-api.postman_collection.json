              "raw": "{\n  \"domain\": \"<string>\",\n  \"workflowId\": \"<string>\",\n  \"signalName\": \"<string>\",\n  \"runId\": \"<string>\",\n  \"input\": \"<string>\"\n}",
              "options": {
